{
	"name": "it-it-tech",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.4.0",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:personal": "PUBLIC_SITE=personal vite dev",
		"build": "vite build",
		"build:company": "node scripts/build-variant.mjs company",
		"build:personal": "node scripts/build-variant.mjs personal",
		"preview": "vite preview",
		"prepare": "node scripts/compile-paraglide.mjs && svelte-kit sync || echo ''",
		"setup": "pnpm install --frozen-lockfile && pnpm exec playwright install chromium && pnpm exec svelte-kit sync",
		"check": "node scripts/compile-paraglide.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "node scripts/compile-paraglide.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "node scripts/prettier.mjs --check . && eslint .",
		"format": "node scripts/prettier.mjs --write .",
		"test:unit": "vitest",
		"test": "vitest --run",
		"test:e2e": "playwright test",
		"test:dev": "node scripts/test-dev.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/fira-code": "^5.3.0",
		"@fontsource/fira-sans": "^5.3.0",
		"@fortawesome/free-brands-svg-icons": "^7.3.1",
		"@inlang/paraglide-js": "^2.29.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.64.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sirv-cli": "^3.0.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
